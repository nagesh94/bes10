# BHIM Solar CRM — the only environment file.
#
# One file for everything: local development and the server both read this, and
# both point at the live Neon database and bucket. Next.js loads `.env`
# automatically, and the standalone scripts read it through Node's
# --env-file-if-exists, so nothing else has to be exported.
#
# NOT in git — `.gitignore` covers `.env`. Keep it that way: it holds live
# credentials. On the server, `chmod 600 .env` and own it as the service user.
#
# NODE_ENV is deliberately absent. Next sets it itself — development for
# `npm run dev`, production for `next start` — and setting it here makes Next
# complain. It is what switches on secure cookies and the strict env checks.

PORT="3000"

# ─────────────────────────────────────────────────────────────────────────────
#  THE ONE LINE TO CHANGE WHEN YOU DEPLOY
# ─────────────────────────────────────────────────────────────────────────────
# Better Auth refuses a sign-in whose Origin is not this, and in production the
# session cookie is HTTPS-only. Locally that means localhost; on the server it
# must be the real https:// URL with no trailing slash, or login silently does
# nothing. Everything else in this file is identical in both places.
# The public URL. Used as-is on the server; `npm run dev` derives
# http://localhost:3000 from NODE_ENV on its own, so this line is correct in
# both places and never needs editing.
AUTH_URL="https://crm.bes247.tech"

# ── Database — the local Postgres container ─────────────────────────────────
# Loopback, so the connection never leaves the machine and needs no TLS. On
# the server this is the container; on your laptop it is either your own
# container or the server's, through an SSH tunnel (see docs/DEPLOY-HOSTINGER.md).
DATABASE_URL="postgresql://bhim:vEpLEHguWSyWnInAdzG732G9EHHt@127.0.0.1:5432/bhim_crm"
DATABASE_SSL="disable"

# docker compose reads these to create that same user and database. The
# password must match the one in DATABASE_URL above.
POSTGRES_USER="bhim"
POSTGRES_PASSWORD="vEpLEHguWSyWnInAdzG732G9EHHt"
POSTGRES_DB="bhim_crm"

DATABASE_POOL_MAX="10"

# ── Object storage — the local MinIO container ──────────────────────────────
# These double as MinIO's root credentials in docker-compose.yml, so the app
# and the container cannot drift apart.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="bhimpt4FWBHSvMKZNfXz"
S3_SECRET_ACCESS_KEY="T02up2ADDQoFzMeVQgcV1juXDEfQnPH6G8MSy2gd"

S3_BUCKET_DOCUMENTS="bhim-documents"
S3_BUCKET_TEMP="bhim-temp"
S3_FORCE_PATH_STYLE="true"
S3_MANAGE_BUCKETS="true"

# ── Off-site backup — this is what Neon is for now ─────────────────────────
# A DEDICATED bucket. Never the app's temp bucket: scripts/cleanup-temp.mjs
# deletes anything older than a day in there, which would silently destroy
# every backup.
BACKUP_S3_ENDPOINT="https://br-shiny-snow-az57dvsl.storage.c-3.ap-southeast-1.aws.neon.tech"
BACKUP_S3_REGION="ap-southeast-1"
BACKUP_S3_ACCESS_KEY_ID="nak_live_92dab474b47c44feacfd287c02e617c5"
BACKUP_S3_SECRET_ACCESS_KEY="nsk_live_bdc50b201f2e7b12a6f02fa2ab3de2067c34de72b7ab92a14df2620f8efd04fd"
BACKUP_S3_BUCKET="bhim-crm-backup"
BACKUP_RETENTION_DAYS="14"

# ── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="9cXoZ10A8qOL2c3RrzvcdayCWrMC37vSgVJ2e0EKQG4="
TOTP_ISSUER="BHIM Energy Solutions"

# ── Field encryption ────────────────────────────────────────────────────────
# Encrypts the Aadhaar column. BACK THIS UP SOMEWHERE OTHER THAN THIS MACHINE.
# Lose it and every stored Aadhaar number is permanently unreadable — a
# database backup does not help, because the ciphertext is useless without it.
# This is the same key you were already using, so existing rows stay readable.
FIELD_ENCRYPTION_KEY="NRjhcPWkhrUgwl7FpBy1qJBdAteI5KNauG0uRvahP/M="

# ── Document conversion ─────────────────────────────────────────────────────
# Gotenberg runs as a container in both places, so the address is the same:
# `docker compose up -d gotenberg` locally, deploy/docker-compose.prod.yml on
# the server.
GOTENBERG_URL="http://localhost:3001"

# ── Email ───────────────────────────────────────────────────────────────────
# Nothing sends mail yet. Mailpit catches it locally (http://localhost:8025).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="BHIM Energy Solutions <no-reply@bes247.tech>"

# ── Documents ───────────────────────────────────────────────────────────────
# Portal variants are squeezed under this. PM Surya Ghar's real cap goes here
# once confirmed.
PORTAL_MAX_FILE_KB="2048"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="BHIM Solar CRM"
NEXT_PUBLIC_DEFAULT_LOCALE="en"      # en | hi
NEXT_PUBLIC_DEFAULT_THEME="system"   # system | light | dark

# ── Seed ────────────────────────────────────────────────────────────────────
# Set a password here and `npm run db:seed` uses it instead of the default
# admin@pass that is written in the repository.
# SEED_ADMIN_EMAIL="nagesh@admin.com"
# SEED_ADMIN_PASSWORD=""
