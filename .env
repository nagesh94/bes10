# BHIM Solar CRM — the only environment file.
#
# Shared values are at the top and never change. Everything that genuinely
# differs between your laptop and the server is collected into ONE block near
# the bottom, with two halves: LOCAL and SERVER. Exactly one half is active at
# a time, so switching environments means moving comments in one place rather
# than hunting through the file.
#
# NOT in git — .gitignore covers `.env`. On the server: chmod 600, owned by
# the `bhim` user.

PORT="3000"

# ── Secrets — identical everywhere, never regenerate ────────────────────────
# openssl rand -base64 32
AUTH_SECRET="9cXoZ10A8qOL2c3RrzvcdayCWrMC37vSgVJ2e0EKQG4="

# Encrypts the Aadhaar column. BACK THIS UP OUTSIDE BOTH MACHINES. Generating
# a new one makes every stored Aadhaar number permanently unreadable, and no
# database backup recovers it.
FIELD_ENCRYPTION_KEY="NRjhcPWkhrUgwl7FpBy1qJBdAteI5KNauG0uRvahP/M="

TOTP_ISSUER="BHIM Energy Solutions"

# ── Public URL — needs no toggle ────────────────────────────────────────────
# Stays the production URL in both places. `npm run dev` sets
# NODE_ENV=development, and src/lib/env.ts derives http://localhost:3000 from
# that on its own, so this line is correct locally too.
AUTH_URL="https://crm.bes247.tech"

# ── Same in both places ─────────────────────────────────────────────────────
# Gotenberg runs as a container on whichever machine you are on.
GOTENBERG_URL="http://localhost:3001"

PORTAL_MAX_FILE_KB="2048"

NEXT_PUBLIC_APP_NAME="BHIM Solar CRM"
NEXT_PUBLIC_DEFAULT_LOCALE="en"      # en | hi
NEXT_PUBLIC_DEFAULT_THEME="system"   # system | light | dark

# Nothing sends email yet; fill in when password reset is built.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="BHIM Energy Solutions <no-reply@bes247.tech>"

# ── Off-site backup — only ever used on the server ──────────────────────────
# A DEDICATED bucket. Never the app's temp bucket: scripts/cleanup-temp.mjs
# deletes anything older than a day in there, which would silently destroy
# every backup. Harmless to leave active locally — nothing reads it unless you
# run `npm run db:backup`.
BACKUP_S3_ENDPOINT="https://br-shiny-snow-az57dvsl.storage.c-3.ap-southeast-1.aws.neon.tech"
BACKUP_S3_REGION="ap-southeast-1"
BACKUP_S3_ACCESS_KEY_ID="nak_live_92dab474b47c44feacfd287c02e617c5"
BACKUP_S3_SECRET_ACCESS_KEY="nsk_live_bdc50b201f2e7b12a6f02fa2ab3de2067c34de72b7ab92a14df2620f8efd04fd"
BACKUP_S3_BUCKET="bhim-crm-backup"
BACKUP_RETENTION_DAYS="14"


# ═══════════════════════════════════════════════════════════════════════════
#  THE ONLY BLOCK THAT CHANGES BETWEEN MACHINES
#
#  Exactly one of the two halves below must be active. Do not edit by hand —
#  flip it with the script, which cannot half-apply the change:
#
#    npm run env:local      # Neon        (your laptop)
#    npm run env:server     # local stack (the VPS)
#
#  Nothing above this line ever needs touching.
# ═══════════════════════════════════════════════════════════════════════════

# >>> LOCAL  (Neon — no containers needed on your laptop)
DATABASE_URL="postgresql://neondb_owner:npg_p7nhUcF5zmJl@ep-soft-feather-az28ntpb.c-3.ap-southeast-1.aws.neon.tech/bhim_crm"
DATABASE_SSL="verify-full"

S3_ENDPOINT="https://br-shiny-snow-az57dvsl.storage.c-3.ap-southeast-1.aws.neon.tech"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID="nak_live_92dab474b47c44feacfd287c02e617c5"
S3_SECRET_ACCESS_KEY="nsk_live_bdc50b201f2e7b12a6f02fa2ab3de2067c34de72b7ab92a14df2620f8efd04fd"
S3_BUCKET_DOCUMENTS="bhim-crm-bucket"
S3_BUCKET_TEMP="bhim-crm-temp"
S3_FORCE_PATH_STYLE="true"
S3_MANAGE_BUCKETS="true"

# <<< LOCAL

# >>> SERVER  (local Postgres + MinIO on the VPS)
# Why not Neon here: the server is in Mumbai and Neon is in Singapore, which
# measured 68 ms PER QUERY — a page doing ten queries would waste 0.7 s. Local
# containers make that sub-millisecond and keep Aadhaar scans in India.
#
# The POSTGRES_* and S3_* values below are also what docker-compose.yml uses to
# create the containers, so the app and Docker cannot drift apart.
#
# DATABASE_URL="postgresql://bhim:sUmdQLFtoYsPZ2VBkA7L2AwKIZmZ@127.0.0.1:5432/bhim_crm"
# DATABASE_SSL="disable"
#
# POSTGRES_USER="bhim"
# POSTGRES_PASSWORD="sUmdQLFtoYsPZ2VBkA7L2AwKIZmZ"
# POSTGRES_DB="bhim_crm"
#
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="bhimHGng6qLYcDtCE9Kz"
# S3_SECRET_ACCESS_KEY="EN4CruugBxPwhHPWGOy4uROb3que21wFWM98ozCi"
# S3_BUCKET_DOCUMENTS="bhim-documents"
# S3_BUCKET_TEMP="bhim-temp"
# S3_FORCE_PATH_STYLE="true"
# S3_MANAGE_BUCKETS="true"
# <<< SERVER

# ── Seed ────────────────────────────────────────────────────────────────────
# Set a password here and `npm run db:seed` uses it instead of the default
# admin@pass that is written in the repository.
# SEED_ADMIN_EMAIL="nagesh@admin.com"
# SEED_ADMIN_PASSWORD=""
