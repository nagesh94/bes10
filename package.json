{
  "name": "bhim-crm",
  "version": "0.1.0",
  "private": true,
  "description": "BHIM Energy Solutions \u2014 residential rooftop solar CRM for PM Surya Ghar",
  "scripts": {
    "dev": "node scripts/with-swc-cache.mjs next dev",
    "build": "node scripts/with-swc-cache.mjs next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env src/lib/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:prod": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "deploy:release": "npm run db:migrate:prod && npm run db:seed",
    "storage:cleanup": "node --env-file-if-exists=.env scripts/cleanup-temp.mjs",
    "smoke:storage": "tsx --env-file-if-exists=.env scripts/smoke-storage.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "env:local": "node scripts/env-mode.mjs local",
    "env:server": "node scripts/env-mode.mjs server",
    "env:which": "node scripts/env-mode.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@hookform/resolvers": "^5.2.2",
    "better-auth": "^1.3.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.10.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "next-intl": "^4.3.9",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
