# BHIM Solar CRM — local POC
# Copy to .env.local. Every value below points at the Docker Compose stack,
# so nothing leaves the machine.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://bhim:bhim_local_dev@localhost:5433/bhim_crm"

# ── Object storage (MinIO locally, S3 or R2 later) ────────────────────────
# Only these four change when this moves to a real cloud bucket.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="bhim_minio"
S3_SECRET_ACCESS_KEY="bhim_minio_local_dev"

S3_BUCKET_DOCUMENTS="bhim-documents"
S3_BUCKET_TEMP="bhim-temp"
# MinIO needs path-style addressing; set false for AWS S3.
S3_FORCE_PATH_STYLE="true"

# ── Auth ──────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
TOTP_ISSUER="BHIM Energy Solutions"

# Encrypts the Aadhaar number column. Must be 32 bytes, base64.
# Losing this makes stored Aadhaar numbers unreadable — back it up.
FIELD_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# ── Email (Mailpit locally — open http://localhost:8025 to read it) ───────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
MAIL_FROM="BHIM Energy Solutions <no-reply@bhimenergy.local>"

# ── Document conversion (Gotenberg = LibreOffice over HTTP) ──────────────
GOTENBERG_URL="http://localhost:3001"

# ── Documents ─────────────────────────────────────────────────────────────
# Portal variants are squeezed under this. PM Surya Ghar's real cap goes here
# once confirmed.
PORTAL_MAX_FILE_KB="2048"

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="BHIM Solar CRM"
NEXT_PUBLIC_DEFAULT_LOCALE="en"      # en | hi
NEXT_PUBLIC_DEFAULT_THEME="system"   # system | light | dark
